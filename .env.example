# ==========================================
# MediSync — Variables de Entorno Globales
# ==========================================

# 1. Configuración Backend (carpeta /backend)
PORT=4000

# Base de datos:
# SQLite (por defecto, no requiere instalación externa):
DATABASE_URL="file:./medisync.db"
# PostgreSQL (opcional para despliegue en producción):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medisync?schema=public"

JWT_SECRET="medisync_super_secret_jwt_key_2026_health_secure"
JWT_EXPIRES_IN="7d"
NODE_ENV="development"

# 2. Configuración App Móvil (carpeta /mobile)
# En Android Emulator usar 10.0.2.2. En dispositivo físico usar la IP local de tu PC:
EXPO_PUBLIC_API_URL="http://10.0.2.2:4000/api"

